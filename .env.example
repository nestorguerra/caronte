FUTURE_BOOK_PRICE_CENTS=4995
FUTURE_BOOK_CURRENCY=EUR
FUTURE_BOOK_DEFAULT_QUESTION_COUNT=21
FUTURE_BOOK_ADMIN_TOKEN=
FUTURE_BOOK_SECRET_KEY=
FUTURE_BOOK_PRIVACY_SALT=
FUTURE_BOOK_RATE_LIMIT_DISABLED=false
FUTURE_BOOK_MONITOR_SECRET=
# Dedicated queue-only recovery. Never reuse the monitor or print credential.
CARONTE_BOOK_WORKER_SECRET=
# Opt-in operations recovery. Activation may continue paid model work; never on by default.
CARONTE_BOOK_RECOVERY_ENABLED=false
# Print processing requires the approved SQL migration and hosted runtime checks.
# Both gates remain off until deployment/activation is explicitly approved.
CARONTE_PRINT_QUEUE_ENABLED=false
CARONTE_PRINT_WORKER_SECRET=
CARONTE_PRINT_RECOVERY_ENABLED=false
FUTURE_BOOK_ALERT_WEBHOOK_URL=
FUTURE_BOOK_DAILY_PROVIDER_CALL_LIMIT=250
FUTURE_BOOK_ACCESS_MODE=fixed_beta
FUTURE_BOOK_REQUIRE_INVITE=false
FUTURE_BOOK_TRANSCRIPTION_API_KEY=
FUTURE_BOOK_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
FUTURE_BOOK_STORE_AUDIO=true
FUTURE_BOOK_MAX_AUDIO_BYTES=25165824
FUTURE_BOOK_ACCESS_DISABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_INTRO_MODEL_ID=eleven_v3
# Afinado del intro expresivo (Eleven v3). Opcionales: si se omiten se usan estos defaults.
# stability bajo = mas expresivo y responde a los audio tags; alto = monotono e ignora tags.
ELEVENLABS_INTRO_STABILITY=0.3
ELEVENLABS_INTRO_SIMILARITY=0.85
ELEVENLABS_INTRO_STYLE=0.35
ELEVENLABS_INTRO_SPEED=0.9
LULU_API_KEY=
# Full print renderer uses the OAuth client pair, not the legacy placeholder above.
# Choose sandbox or production explicitly. No implicit production environment.
LULU_ENVIRONMENT=
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# Activate only after verifying the Lulu account has automatic payment disabled.
# Never creates a payment; creation itself can charge if the account has autopay.
FUTURE_BOOK_LULU_ORDERS_ENABLED=false
