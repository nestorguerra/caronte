INGESTION_SECRET=
RESEND_API_KEY=
NOTIFICATION_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
FUTURE_BOOK_OPENAI_MODEL=gpt-6.1-sol
FUTURE_BOOK_MAP_MODEL=gpt-6.1-sol
